# Exercise the complete source -> extrusion -> CityJSON attribute path.
execute_process(
  COMMAND "${ROOFER_EXE}" --config "${CONFIG_FILE}" --jobs 4
          --underpass-attributes identificatie,underpass_id
          "${OUTPUT_DIR}"
  RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Underpass reconstruction failed: ${status}")
endif()

file(GLOB outputs "${OUTPUT_DIR}/*.city.jsonl")
set(with_underpass 0)
set(without_underpass 0)
foreach(output IN LISTS outputs)
  file(STRINGS "${output}" lines)
  foreach(line IN LISTS lines)
    string(JSON type GET "${line}" type)
    if(NOT type STREQUAL "CityJSONFeature")
      continue()
    endif()
    string(JSON objects GET "${line}" CityObjects)
    string(JSON count LENGTH "${objects}")
    math(EXPR last "${count} - 1")
    set(has_ceiling FALSE)
    foreach(i RANGE 0 ${last})
      string(JSON id MEMBER "${objects}" ${i})
      string(JSON object GET "${objects}" "${id}")
      string(JSON type GET "${object}" type)
      if(type STREQUAL "Building")
        set(building_id "${id}")
        string(JSON flag_type TYPE "${object}" attributes rf_has_underpass)
        if(NOT flag_type STREQUAL "BOOLEAN")
          message(FATAL_ERROR "rf_has_underpass must be boolean on ${id}")
        endif()
        string(JSON flag GET "${object}" attributes rf_has_underpass)
      else()
        string(JSON geometries GET "${object}" geometry)
        string(JSON count LENGTH "${geometries}")
        math(EXPR last_geometry "${count} - 1")
        foreach(g RANGE 0 ${last_geometry})
          string(JSON surfaces GET "${geometries}" ${g} semantics surfaces)
          string(JSON count LENGTH "${surfaces}")
          math(EXPR last_surface "${count} - 1")
          foreach(s RANGE 0 ${last_surface})
            string(JSON surface GET "${surfaces}" ${s})
            string(JSON type GET "${surface}" type)
            if(type STREQUAL "OuterCeilingSurface")
              set(has_ceiling TRUE)
              string(JSON source_id GET "${surface}" identificatie)
              string(JSON attribute_type TYPE "${surface}" underpass_id)
              string(JSON parent GET "${object}" parents 0)
              if(NOT source_id STREQUAL parent OR NOT attribute_type STREQUAL "NUMBER")
                message(FATAL_ERROR "Ceiling attributes do not match source for ${id}")
              endif()
            endif()
          endforeach()
        endforeach()
      endif()
    endforeach()
    if((flag AND NOT has_ceiling) OR (has_ceiling AND NOT flag))
      message(FATAL_ERROR "Incorrect rf_has_underpass for ${building_id}")
    endif()
    if(flag)
      math(EXPR with_underpass "${with_underpass} + 1")
    else()
      math(EXPR without_underpass "${without_underpass} + 1")
    endif()
  endforeach()
endforeach()
if(NOT with_underpass EQUAL 2 OR NOT without_underpass EQUAL 2)
  message(FATAL_ERROR "Expected two buildings with underpasses and two without; got ${with_underpass}/${without_underpass}")
endif()
